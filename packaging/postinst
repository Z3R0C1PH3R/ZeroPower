#!/bin/sh
# ZeroPower: zeropowerd is a user service (like the launcher, APPLaunch.service). Enable it
# for every user and start it now for the device user if they are logged in.
set -e
if [ "$1" = "configure" ]; then
    systemctl --global enable zeropowerd.service >/dev/null 2>&1 || true
    user=$(getent passwd 1000 | cut -d: -f1)
    if [ -n "$user" ] && [ -d /run/user/1000/systemd ]; then
        systemctl --user -M "$user@" daemon-reload >/dev/null 2>&1 || true
        systemctl --user -M "$user@" restart zeropowerd.service >/dev/null 2>&1 || true
    fi
fi
exit 0
